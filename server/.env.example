PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/embrowerment
# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Encrypts Stripe/SMTP secrets stored in the database (any long random string; never change after first use)
ENCRYPTION_KEY=change-me-too
# Public URLs (comma-separate multiple origins for CORS)
CLIENT_URL=http://localhost:8080
ADMIN_URL=http://localhost:5175
API_URL=http://localhost:4000
# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@embrowerment.com
ADMIN_PASSWORD=ChangeMe123!
# Set true in production (HTTPS) so auth cookies are Secure
COOKIE_SECURE=false
# Development only: route Stripe API calls to stripe-mock (https://github.com/stripe/stripe-mock). Leave unset in production.
# STRIPE_API_BASE=http://localhost:12111
# Optional: DNS servers for mongodb+srv lookups (fixes "querySrv ECONNREFUSED" on some networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1
